{
  "name": "pocket-notch",
  "productName": "Pocket Notch",
  "version": "1.0.6",
  "description": "Pocket Notch (P-Notch): dynamic-island / notch interaktif untuk Windows dengan tema retro neon dan karakter pendamping",
  "main": "src/main/main.js",
  "author": "Kyousa",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:mock": "electron . --mock",
    "test": "node test/run.js",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.pocketnotch.app",
    "productName": "Pocket Notch",
    "copyright": "Copyright (c) Pocket Notch",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pocket Notch",
      "uninstallDisplayName": "Pocket Notch (P-Notch)",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "daffawiradz",
        "repo": "pocket-notch",
        "releaseType": "release"
      }
    ]
  }
}
